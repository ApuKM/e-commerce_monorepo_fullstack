# packages/kafka — KafkaJS connection configuration
# Local dev (Docker Compose): leave KAFKA_USERNAME / KAFKA_PASSWORD unset for plaintext
# KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096

# Production (Confluent Cloud / Redpanda Cloud): SASL_SSL is enabled automatically
KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_USERNAME=your-kafka-api-key
KAFKA_PASSWORD=your-kafka-api-secret
# Options: plain (Confluent Cloud default) | scram-sha-256 | scram-sha-512 (Redpanda)
KAFKA_SASL_MECHANISM=plain
# Optional explicit TLS override when SASL is not used
# KAFKA_SSL=true

