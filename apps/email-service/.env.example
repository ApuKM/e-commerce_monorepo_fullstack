# apps/email-service — set these in Railway Service > Variables

# Gmail OAuth2 (via Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Kafka (Confluent Cloud or Redpanda Cloud)
KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_USERNAME=your-kafka-api-key
KAFKA_PASSWORD=your-kafka-api-secret
KAFKA_SASL_MECHANISM=plain

# Platform
NODE_ENV=production
# PORT is set automatically by Railway (health server listens on it)

