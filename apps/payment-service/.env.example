# apps/payment-service — set these in Railway Service > Variables

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_RETURN_URL=https://your-client.vercel.app

# Kafka (Confluent Cloud or Redpanda Cloud)
KAFKA_BROKERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_USERNAME=your-kafka-api-key
KAFKA_PASSWORD=your-kafka-api-secret
KAFKA_SASL_MECHANISM=plain

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-client.vercel.app,https://your-admin.vercel.app

# Platform
NODE_ENV=production
# PORT is set automatically by Railway

