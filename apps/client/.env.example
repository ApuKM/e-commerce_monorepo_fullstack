# apps/client — set these in Vercel Dashboard > Project Settings > Environment Variables

# Clerk (use production keys on live deployment)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Backend service URLs — replace with your Railway production URLs
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://product-service.up.railway.app
NEXT_PUBLIC_PAYMENT_SERVICE_URL=https://payment-service.up.railway.app
NEXT_PUBLIC_ORDER_SERVICE_URL=https://order-service.up.railway.app

# Stripe (use pk_live_... in production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

